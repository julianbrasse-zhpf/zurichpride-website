---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const settings = await getSiteSettings();
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline}>
	<div>
		<h1>Zurich Pride Demonstration 2026</h1>
		<p>Save the date!</p>
		<p>Samstag, 20. Juni</p>
		<a href="https://pride-festival-zurich.shop.bookinea.app/de/c/party-tickets-1804">Pride Party Tickets</a>
	</div>
</Base>